{
  "version": "0.2.0",
  "configurations": [
    //- cấu hình debug api gateway (cổng inspect 9229)
    {
      "name": "Debug API Gateway",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:debug",
        "api-gateway",
        "--",
        "--debug=9229"
      ],
      "console": "integratedTerminal",
      "restart": true
    },
    //- cấu hình debug auth service (cổng inspect 9230)
    {
      "name": "Debug Auth Service",
