      "restart": true
    }
  ],
  "compounds": [
    //- cấu hình chạy đồng thời toàn bộ các microservices với cổng debug riêng biệt không bị trùng nhau
    {
      "name": "🚀 Debug All Microservices",
      "configurations": [
        "Debug API Gateway",
        "Debug Auth Service",
        "Debug Order Service",
        "Debug Notification Service",
        "Debug Inventory Service"
      ],
      "stopAll": true
    }
  ]
