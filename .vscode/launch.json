      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug", "api-gateway"],
      "console": "integratedTerminal",
      "restart": true
    },
    {
      "name": "Debug Order Service",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug", "order-service"],
      "console": "integratedTerminal",
      "restart": true
    },
    {
      "name": "Debug Notification Service",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug", "notification-service"],
      "console": "integratedTerminal",
      "restart": true
    },
    {
      "name": "Debug Inventory Service",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug", "inventory-service"],
      "console": "integratedTerminal",
      "restart": true
    }
  ],
  "compounds": [
    {
      "name": "🚀 Debug All Microservices",
